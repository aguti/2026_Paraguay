	\draw [line width=3.0,blue,>=latex,->]  ( $(xa) + ( 1.5 , 0.5 )$ ) to[out=0,in=130] (  $(xa) + ( 2.8 , -0.2 )$ );

	\draw [line width=1.0,>=latex,->] ( $(xa) + ( -0.1 , -2.0 )$ ) -- ( $(xa) + ( 1.5 , -2.0 )$ ) node[scale=1.5, below ] {$t$};
	\draw [line width=1.0,>=latex,->] ( $(xa) + (  0.0 , -2.1 )$ ) -- ( $(xa) + ( 0.0 , -1.0 )$ ) node[scale=1.5, above ] {$p^{nc}_{i+1}(t)$};
	\draw [line width=0.5, red] plot[samples=100, domain=2:3.5 ] function{ (1 + sin(-5*(x - 2)))/2 - 8.0};
	\draw [line width=3.0,red,>=latex,->]  ( $(xa) + ( 1.5 , -1.5 )$ ) to[out=0,in=230] (  $(xa) + ( 2.8 , -0.8 )$ );

	\draw [line width=1.0,>=latex,->] ( $(xa) + (  2.9 , -1.0 )$ ) -- ( $(xa) + ( 5.0 , -1.0 )$ ) node[scale=1.5, below ] {$t$};
	\draw [line width=1.0,>=latex,->] ( $(xa) + (  3.0 , -1.1 )$ ) -- ( $(xa) + ( 3.0 ,  0.5 )$ ) node[scale=1.5, above ] {$p_{i+1}(t)$};
