	\draw [line width=0.5,orange,fill=orange!20] (4.6,-1.7) rectangle (4.9,-1.4);
	\draw [line width=0.5,orange,fill=orange!20] (4.6,-1.4) rectangle (4.9,-1.1);
	% ELIPSE EQUATION: (x/a)^2 + (y/b)^2 = 1
	\pgfmathparse{ 3.1 * \rPos }\let\xp = \pgfmathresult
	\pgfmathparse{ ( 1.6 * sqrt( 1 - ( \xp / 3.1 )^2 ) ) }\let\yp = \pgfmathresult
	\pgfmathparse{ \xp + 1.5 }\let\xpos = \pgfmathresult
	\pgfmathparse{ \yp - 1.1 }\let\ypos = \pgfmathresult
	\draw [line width=0.5,orange,fill=orange!20] (\xpos,\ypos) rectangle ({\xpos + 0.3},{\ypos + 0.3});	
	\end{tikzpicture}
}

\end{animateinline}
