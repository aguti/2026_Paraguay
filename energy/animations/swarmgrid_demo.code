\newcommand{\baseSGD}{%
	% Signal
	\coordinate (signal) at (0.0,0.0);	
	% Axis
	\draw ( $(signal) + (0.0,0.0)$ ) rectangle ( $(signal) + (30.0,10.0)$);	
	\node[scale=3.0, anchor=north,align=center] at ($(signal) + (15.0,11.5)$) {Aggregated consumption};
	\foreach \i in {0,1,...,5}{
		\pgfmathparse{int(\i*4.8 + 0.1) + 16}\let\result=\pgfmathresult
		\pgfmathparse{ \i*2.0 )}\let\pos=\pgfmathresult
		\draw [line width=4.0 ] ($(signal) + ( -0.2 , \pos )$) node [left,scale=2.0]{$\result$} -- ($(signal) + ( 0.2 , \pos )$);
	}
	\node[scale=3.0, rotate=90 ] at ($(signal) + ( -4.0 , 5.0 )$) {P(GW)};
%	\node[scale=3.0 ]            at ($(signal) + ( 15.0 , -2.0 )$) {Time(day)};

	% FFT
	\coordinate (fft) at (0.0,-7.0);
	% Axis
	\draw ( $(fft) + (0.0,0.0)$ ) rectangle ( $(fft) + (30.0,5.0)$);
	\node[scale=3.0, anchor=north,align=center] at ($(fft) + (15.0,6.5)$) {FFT of aggregated consumption};
	\foreach \i in {0,1,...,5}{		
		\pgfmathparse{\i*1}\let\result = \pgfmathresult
		\draw [line width=4.0 ] ($(fft) + ( -0.2 , \i )$) node [left,scale=2.0]{$\result$} -- ($(fft) + ( 0.2 , \i )$);
	}
	\node[scale=3.0, rotate=90 ] at ($(fft) + ( -4.0 , 2.5 )$) {P(MW)};
	

}

\begin{animateinline}[autoplay,loop,width=11cm]{10}
\multiframe{420}{rPos=100+1}{ %520 o 420-100
	\begin{tikzpicture}

	\baseSGD
	\pgfmathparse{mod( 0.133928571 * \rPos * 8 , 3.214285714 )}\let\shift=\pgfmathresult
	\foreach \i in {1,...,10}{
		\pgfmathparse{\i*3.214285714 - \shift}\let\pos=\pgfmathresult
		\pgfmathparse{\pos<=30?1:0}
		\ifnum\pgfmathresult=1			
			\draw [line width=4.0 ] ($(signal) + ( \pos , -0.2 )$) -- ($(signal) + ( \pos , 0.2 )$);
		\fi
	}
	% AGGREGATED CONSUMPTION
	\pgfmathparse{int(\rPos*8)}\let\time=\pgfmathresult
	\draw [line width=0.25 , red ] plot[smooth, raw gnuplot] function{plot "animations/swarmgrid_demo" every ::(0+\time)::(224+\time) u ( ($0) * 30.0 / 224 ):( ( ( ($1) - 16000 ) / 24000 ) * 10.0 )};
	\draw [line width=0.25       ] plot[smooth, raw gnuplot] function{plot "animations/swarmgrid_demo_no" every ::(0+\time)::(224+\time) u ( ($0) * 30.0 / 224 ):( ( ( ($1) - 16000 ) / 24000 ) * 10.0 )};
	% FFT
	\pgfmathparse{int( int( \rPos / 4 ) + 8)}\let\time=\pgfmathresult
	\draw [line width=0.25 , red ] plot[raw gnuplot] function{plot "animations/swarmgrid_demo_famp" every ::0::256 u (($0) * 30.0 / 256 ):(($\time) * 5.0/ 5000 - 7.0 ) }; 
	\draw [line width=0.25       ] plot[raw gnuplot] function{plot "animations/swarmgrid_demo_famp_no" every ::0::256 u (($0) * 30.0 / 256 ):(($\time) * 5.0/ 5000 - 7.0 ) }; 

	\end{tikzpicture}
}
\end{animateinline}











