	\draw[line width=5.0, green] plot[smooth, raw gnuplot] function{set xrange[0:32]; plot ((10-1.0*\rPos)*sin(2*pi*x/24 + pi/2))};
%	\draw (0.0,7.0) node [scale=5.0, left, green] {$A_{n} sin ( n \omega_{0} t + \phi_{n} )$};
	\end{tikzpicture}
}
