	\begin{tikzpicture}	
	%Axis
	\draw [line width=4.0,>=latex,->] (-1.0,0)  -- (32.0,0) node[scale=6.0, below ]{$t$}; 
	\draw [line width=4.0,>=latex,->] (0,-11.0) -- (0,11.0) node[scale=6.0, above left]{$P$};
