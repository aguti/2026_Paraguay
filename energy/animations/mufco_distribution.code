\begin{animateinline}[autoplay,loop,width=11cm]{10}
\multiframe{110}{rPos=0+1}{ %110
	\begin{tikzpicture}

	% FFT
	\coordinate (fft) at ( 0.0 , 0.0 );
	% Axis
	\draw ( $(fft) + (0.0,0.0)$ ) rectangle ( $(fft) + ( 10.0 , 10.0 )$);
	\node[scale=2.5, anchor=north,align=center] at ($(fft) + ( 5.0 , 13.0 )$) {FFT of \\ aggregated consumption};
	\foreach \i in {0,1,...,5}{		
		\pgfmathparse{\i}\let\result = \pgfmathresult
		\pgfmathparse{\i*10.0/5.0}\let\pos    = \pgfmathresult
		\draw [line width=2.0 ] ($(fft) + ( -0.2 , \pos )$) node [left,scale=2.0]{$\result$} -- ($(fft) + ( 0.2 , \pos )$);
	}
	\node[scale=2.5, rotate=90 ] at ($(fft) + ( -2.0 , 5.0 )$) {P(GW)};
%	\pgfmathparse{int( int( \rPos / 4 ) + 8)}\let\time=\pgfmathresult
	\draw [line width=0.25 ] plot[raw gnuplot] function{plot "animations/mufco_demo_famp" u (($0) * 10.0 / 146 ):(($1) * 10.0/ 5000 ) }; 


	% Oscillators
	\coordinate (osc) at ( 15.0 , 0.0 );
	% Axis
	\draw ( $(osc) + (0.0,0.0)$ ) rectangle ( $(osc) + ( 10.0 , 10.0 )$);	
	\node[scale=2.5, anchor=north,align=center] at ($(osc) + ( 5.0 , 12.0 )$) {Oscillator distribution};
	\foreach \i in {0,1,...,3}{		
		\pgfmathparse{int(\i*100)}\let\result=\pgfmathresult
		\pgfmathparse{ 10 * \i / 3 )}\let\pos=\pgfmathresult
		\draw [line width=2.0 ] ($(osc) + ( -0.2 , \pos )$) node [left,scale=2.0]{$\result$} -- ($(osc) + ( 0.2 , \pos )$);
	}
	\node[scale=2.5, rotate=90 ] at ($(osc) + ( -2.5 , 5.0 )$) {$N_{osc}$};
	\pgfmathparse{int( \rPos + 20 ))}\let\time=\pgfmathresult
	\draw [line width=0.25 ] plot[smooth, raw gnuplot] function{plot "animations/mufco_distribution" u ( ($0) * (45*1024)/(16*315) * 10.0 / 146 + 15.0):(($\time) * 10.0/ 300 - 0.0 ) }; %$  %($0) * 25.0 / 17 
	\end{tikzpicture}
}
\end{animateinline}
