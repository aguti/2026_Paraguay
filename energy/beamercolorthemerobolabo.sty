%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% Some computations dedicated to the robolabo...
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newdimen\robolabo@currentbarlength
\newdimen\robolabo@framenumberrectangle
\newdimen\robolabo@titlerectangle
\newdimen\robolabo@leftbar
\newdimen\robolabo@tmpresult
\newdimen\robolabo@barlength

\newdimen\robolabo@stepbar

\newcount\robolabo@numer
\newcount\robolabo@denom

\robolabo@framenumberrectangle=\paperwidth
\robolabo@titlerectangle=\paperwidth

\robolabo@leftbar=0.15cm
\robolabo@barlength=\paperwidth

\newbox\robolabo@framenumberbox

\newcount\robolabo@firstpb
\robolabo@firstpb=0

\def\insertrobolabo{
  \ifnum\insertintermediateframenumber=1\else

    \ifnum\robolabo@firstpb=0
      \setbox\robolabo@framenumberbox=\hbox{\usebeamerfont{section in head/foot}\color{fg}\inserttotalframenumber~/~\inserttotalframenumber}
      \newdimen\robolabo@framenumberboxwidth
      \robolabo@framenumberboxwidth=\wd\robolabo@framenumberbox
      
      \global\advance\robolabo@framenumberrectangle by -0.15cm
      \global\advance\robolabo@framenumberrectangle by -0.5\robolabo@framenumberboxwidth
      \global\advance\robolabo@titlerectangle by -0.3cm
      \global\advance\robolabo@titlerectangle by -\robolabo@framenumberboxwidth

      \global\advance\robolabo@barlength by -\robolabo@framenumberboxwidth
      \global\advance\robolabo@barlength by -0.45cm

      \robolabo@numer=1
      \robolabo@denom=\insertintermediateframenumber
      \advance\robolabo@denom by -1
      \robolabo@tmpresult=\robolabo@barlength
      \multiply\robolabo@tmpresult by \robolabo@numer
      \divide\robolabo@tmpresult by \robolabo@denom
      \global\robolabo@stepbar=\robolabo@tmpresult

      \global\robolabo@currentbarlength=-\robolabo@stepbar

      \global\robolabo@firstpb=1
    \fi

  
    \global\robolabo@currentbarlength=\insertframenumber\robolabo@stepbar
    \global\advance\robolabo@currentbarlength by -\robolabo@stepbar
    
    \begin{tikzpicture}[thin]
      \usebeamercolor{section in head/foot}
      \useasboundingbox (0, 0) rectangle  (\paperwidth, 0.6cm);
      %\draw (\robolabo@framenumberrectangle, 0.21cm) node [anchor=mid] {\color{fg}\insertframenumber~/~\insertintermediateframenumber};
      %\draw (\robolabo@framenumberrectangle, 0.21cm) node [anchor=mid] {\color{fg}\insertframenumber};
      %\draw (\robolabo@framenumberrectangle, 0.21cm) node [anchor=mid];
      %\draw (\robolabo@titlerectangle, 0.21cm) node [anchor=south east] {\color{fg}\insertshorttitle};
      \draw[fg!30!bg, <->, >=serif cm] (\robolabo@leftbar, 0.21cm) -- (\robolabo@titlerectangle, 0.21cm);
      \draw (\robolabo@currentbarlength, 0.21cm)
      ++(\robolabo@leftbar, 0cm) node[anchor=north] {\color{fg!30!bg}$\blacktriangle$};
    \end{tikzpicture}
    \fi
}

