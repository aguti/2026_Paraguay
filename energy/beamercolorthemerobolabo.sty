\defbeamertemplate*{title page}{robolabo theme}{
  \edef\tempa{picture}
  \ifx\robolabo@titlepage\tempa
  \vfill
  \parbox{0.28\textwidth}{
    \begin{center}
    %\pgfimage[width=0.17\textwidth]{\upm@imagename}
    %\vspace{1.0cm}
    %\pgfimage[width=0.27\textwidth]{\etsit@imagename}
    %\vspace{1.0cm}
    %\pgfimage[width=0.27\textwidth]{\gedirci@imagename}
    %\vspace{1.0cm}
    %\pgfimage[width=0.27\textwidth]{\robolabo@imagename}
    \pgfimage[width=0.27\textwidth]{\swarm@imagename}
    \vspace{0.5cm}
    \pgfimage[width=0.27\textwidth]{\robolabo@imagename}
    \vspace{0.2cm}
    %\pgfimage[width=0.30\textwidth]{\eires@imagename}
    \end{center}
  }\hfill
  \parbox{0.7\textwidth}{
    \begin{center}
      {\usebeamerfont{title}\usebeamercolor{title}{\color{fg}\inserttitle}}
      \ifx\insertsubtitle\@empty\\[\baselineskip]
      \else{\\\usebeamerfont{subtitle}\usebeamercolor{subtitle}{\color{fg}\insertsubtitle}}\\[\baselineskip]\fi
      \hrule\vskip\baselineskip
      \ifx\insertauthor\@empty\ \\
      \else{\usebeamerfont{author}\usebeamercolor{author}{\color{fg}\insertauthor}}\\\fi
      \ifx\insertdate\@empty\ \\
      \else{\usebeamerfont{date}\usebeamercolor{date}{\color{fg}\insertdate}}\\\fi
      \ifx\insertinstitute\@empty
      \else{\vspace{0.5cm}\usebeamerfont{institute}\usebeamercolor{institute}{\color{fg}\insertinstitute}}\\\fi
      \insertlogo
    \end{center}
  }\vfill
  \else
  \pgfdeclarehorizontalshading{separationtitlepagelineshading}{0.5pt}{color(0cm)=(bg); 
    color(0.5\textwidth)=(structure.fg); color(\textwidth)=(bg)}
  \begin{center}
    \vfill
    {\usebeamerfont{title}\usebeamercolor{title}{\color{fg}\inserttitle}}

    \ifx\insertsubtitle\@empty 
    \else{\usebeamerfont{subtitle}\usebeamercolor{subtitle}{\color{fg}\insertsubtitle}}\\[\baselineskip]\fi

    \pgfuseshading{separationtitlepagelineshading}
    \ifx\insertauthor\@empty\ \\
    \else{\usebeamerfont{author}\usebeamercolor{author}{\color{fg}\insertauthor}}\\\fi
    \ifx\insertdate\@empty\ \\
    \else{\usebeamerfont{date}\usebeamercolor{date}{\color{fg}\insertdate}}\\\fi
    \ifx\insertinstitute\@empty
    \else{\vspace{0.5cm}\usebeamerfont{institute}\usebeamercolor{institute}{\color{fg}\insertinstitute}}\\\fi
    \insertlogo
    \pgfuseshading{separationtitlepagelineshading}
    \vfill
  \end{center}
  \fi
}

\setbeamertemplate{title page}[robolabo theme]


